---
import HeaderLink from "./HeaderLink.astro";
// https://docs.astro.build/en/reference/configuration-reference/#experimental-flags
import { MoonIcon } from "@phosphor-icons/react/dist/ssr/Moon";
import { SunIcon } from "@phosphor-icons/react/dist/ssr/Sun";
import { TwitterLogoIcon } from "@phosphor-icons/react/dist/ssr/TwitterLogo";
import { GithubLogoIcon } from "@phosphor-icons/react/dist/ssr/GithubLogo";
import { ThemeSwitch } from "astro-color-scheme";

type Props = {
  className?: string;
};

const { className } = Astro.props;
---

<header
  class:list={[
    "border-slate-3 flex flex-col border-b md:border-r md:border-b-0 print:hidden",
    className,
  ]}
>
  <h2 class="justify-left text-slate-12 flex w-full font-mono">
    <HeaderLink href="/"> oh dear lordy lord </HeaderLink>
    <ThemeSwitch strategy="button">
      <button>
        <span class="sr-only">Toggle Theme</span>
        <span class="dark:hidden"><SunIcon /></span>
        <span class="hidden dark:block"><MoonIcon /></span>
      </button>
    </ThemeSwitch>
  </h2>
  <div class="mt-4 mb-4 flex w-full justify-center gap-4">
    <HeaderLink href="https://github.com/dearlordylord" target="_blank">
      <GithubLogoIcon size={18} />
    </HeaderLink>
    <!-- TODO TIL -->
    <!-- TODO presentations -->
    <!-- TODO apps -->
    <!-- TODO resume -->
    <!-- TODO dnd -->
    <HeaderLink href="https://twitter.com/ohdearlordylord" target="_blank">
      <TwitterLogoIcon size={18} />
    </HeaderLink>
  </div>
</header>
